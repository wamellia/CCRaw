include LICENSE NOTICE README.md THIRD_PARTY.md MODEL.md
include requirements*.txt main.py pyproject.toml
include *.spec *.ps1 *.cmd installer.iss
include CONTRIBUTING.md
recursive-include .github *.yml
recursive-include ccraw *.py *.svg *.ico *.png *.jpg *.webp *.json *.ttf *.txt
recursive-include assets *.json *LICENSE*.txt OFL.txt ccraw.ico ccraw.svg
recursive-include tools *.py *.ps1
recursive-include tests *.py
recursive-include docs *.md *.webp
global-exclude __pycache__ *.pyc *.nbc *.nbi
prune build
prune dist
prune .venv
prune .venv-release
prune release-assets
prune licenses
prune .pytest_cache
prune .asset-cache
