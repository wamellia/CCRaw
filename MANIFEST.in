include LICENSE NOTICE README.md README.en.md THIRD_PARTY.md
include main.py pyproject.toml
recursive-include requirements *.txt *.md
include setup.cfg
include *.spec *.ps1 *.cmd installer.iss
include CONTRIBUTING.md
recursive-include .github *.yml
recursive-include ccraw *.py *.svg *.ico *.png *.jpg *.webp *.json *.ttf *.otf *.txt
recursive-include ccraw/resources *.dll
recursive-include assets *.json *LICENSE*.txt OFL.txt ccraw.ico ccraw.svg
recursive-include tools *.py *.ps1 *.cmd *.md
recursive-include tests *.py
recursive-include tests/fixtures/watermark-standard1 *.png *.json
recursive-include docs *.md *.webp
global-exclude __pycache__ *.pyc *.nbc *.nbi
prune build
prune dist
prune .venv
prune .venv-release
prune release-assets
prune licenses
prune .pytest_cache
prune .asset-cache
